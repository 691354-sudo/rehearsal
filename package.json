{
  "name": "language-rehearsal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:codex": "bash scripts/dev-codex.sh",
    "dev:api": "node --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:seed": "node --import tsx server/db/seed.ts",
    "db:embed": "node --import tsx server/db/embed.ts",
    "db:replace-library": "node --import tsx scripts/db-replace-library.ts",
    "db:set-language": "node --import tsx scripts/db-set-language.ts",
    "models:check": "node --import tsx scripts/check-openai-models.ts",
    "db:backup": "node --import tsx scripts/db-backup.ts",
    "db:restore": "node --import tsx scripts/db-restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "lucide-react": "^1.33.0",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^5.4.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "glob": "13.0.6"
  }
}
