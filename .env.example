# The key stays on the API server and is never exposed to the browser.
OPENAI_API_KEY=

# Pinned workload roles. Change deliberately, then run `npm run models:check`.
OPENAI_TUTOR_MODEL=gpt-5.6-sol
OPENAI_BALANCED_MODEL=gpt-5.6-terra
OPENAI_UTILITY_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=onyx

# Optional ElevenLabs voice provider. Library voices require a paid API plan.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=1YGgSmpRGVzkcaI7zhbX
ELEVENLABS_VOICE_NAME=Christopher
# Vietnamese defaults to the existing Vietnamese ElevenLabs voice.
ELEVENLABS_VI_VOICE_ID=ueSxRO0nLF1bj93J2hVt
ELEVENLABS_VI_VOICE_NAME=Trung Caha
# Configure an approved native Norwegian Bokmål voice before enabling production playback.
ELEVENLABS_NO_VOICE_ID=
ELEVENLABS_NO_VOICE_NAME=
# Indonesian defaults to the saved Zephlyn voice; override only with another verified native voice.
ELEVENLABS_ID_VOICE_ID=3mAVBNEqop5UbHtD8oxQ
ELEVENLABS_ID_VOICE_NAME=Zephlyn
ELEVENLABS_MODEL=eleven_multilingual_v2
# ElevenLabs accepts 0.7 through 1.2.
ELEVENLABS_SPEED=1.05

API_HOST=127.0.0.1
API_PORT=8787
DATABASE_PATH=.data/rehearsal.sqlite
BACKUP_DIR=backups
DATA_DIR=.data

# Required when the profile registry is first created. Use 4-12 digits and keep
# real values only in the local/production secret store, never in this file.
ROMAN_PROFILE_PIN=
OLIVER_PROFILE_PIN=
ZANNA_PROFILE_PIN=
# Production may set the matching *_PROFILE_PIN_FILE values instead.

# Generate a long random value (at least 32 bytes). Production cookies are
# Secure by default; local HTTP development may set SESSION_COOKIE_SECURE=false.
SESSION_SECRET=
# Production may set SESSION_SECRET_FILE instead.
SESSION_COOKIE_SECURE=false
TRUST_PROXY=

# Optional Telegram bot and Mini App. The bot starts only from a token file.
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_ALLOWED_PROFILE_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MINI_APP_URL=
