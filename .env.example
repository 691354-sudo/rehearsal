# The key stays on the API server and is never exposed to the browser.
OPENAI_API_KEY=

# Workload routing. The model checker can update these roles at runtime.
OPENAI_TUTOR_MODEL=gpt-5.6-sol
OPENAI_BALANCED_MODEL=gpt-5.6-terra
OPENAI_UTILITY_MODEL=gpt-5.6-luna
OPENAI_MODEL_AUTO_UPDATE=true
OPENAI_MODEL_CHECK_INTERVAL_DAYS=14
OPENAI_MODEL_ROUTING_PATH=.data/model-routing.json
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Optional ElevenLabs voice provider. Library voices require a paid API plan.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=1YGgSmpRGVzkcaI7zhbX
ELEVENLABS_VOICE_NAME=Christopher
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.60
ELEVENLABS_STYLE=0.02
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.05

API_HOST=127.0.0.1
API_PORT=8787
DATABASE_PATH=.data/rehearsal.sqlite
BACKUP_DIR=backups
